<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Caldeira_Industrial">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="PAINEL DE CONTROLE DA CALDEIRA"
            android:textSize="18sp"
            android:textStyle="bold" />
conse
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnergia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energia Principal (Desligada / Ligada)" />

        <ToggleButton
            android:id="@+id/toggleTrava"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textOff="Trava de Segurança: TRAVADA"
            android:textOn="Trava de Segurança: DESTRAVADA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tipo de Combustível:"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCombustivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbGas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gás" />

            <RadioButton
                android:id="@+id/rbBiomassa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Biomassa" />
        </RadioGroup>

        <EditText
            android:id="@+id/edtPressaoMaxima"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Pressão Máxima de Trabalho (em PSI)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnIniciarAquecimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Iniciar Aquecimento" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPressurizar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Pressurizar (+10 PSI)" />

            <Button
                android:id="@+id/btnDespressurizar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Despressurizar (-10 PSI)" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status do Sistema / Logs"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            android:focusable="false"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="always"
            android:padding="8dp"
            android:scrollbars="vertical" />

    </LinearLayout>
</ScrollView>