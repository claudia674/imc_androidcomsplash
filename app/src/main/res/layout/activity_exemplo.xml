<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Exemplo">

    <ToggleButton
        android:id="@+id/situacao2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textOff="Desligado"
        android:textOn="Ligado"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <RadioButton
        android:id="@+id/aberto"
        android:layout_width="213dp"
        android:layout_height="51dp"
        android:layout_marginTop="92dp"
        android:text="Aberto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.518"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/situacao2" />

    <Switch
        android:id="@+id/situacao"
        android:layout_width="152dp"
        android:layout_height="39dp"
        android:layout_marginTop="132dp"
        android:text="Desligado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fechado" />

    <RadioButton
        android:id="@+id/fechado"
        android:layout_width="216dp"
        android:layout_height="49dp"
        android:layout_marginTop="8dp"
        android:text="Fechado"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.528"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aberto" />

    <TextView
        android:id="@+id/Aberto"
        android:layout_width="263dp"
        android:layout_height="183dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toBottomOf="@+id/situacao2"
        tools:layout_editor_absoluteX="74dp" />

    <EditText
        android:id="@+id/LIGADO"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:ems="10"
        android:hint="LIGADO"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/situacao" />

    <EditText
        android:id="@+id/DESLIGADO"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ems="10"
        android:hint="DESLIGADO"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/LIGADO" />

    <EditText
        android:id="@+id/resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ems="10"
        android:hint="resultado"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/DESLIGADO" />

    <EditText
        android:layout_width="278dp"
        android:layout_height="190dp"
        android:ems="10"
        android:inputType="text"
        tools:layout_editor_absoluteX="74dp"
        tools:layout_editor_absoluteY="483dp" />

</androidx.constraintlayout.widget.ConstraintLayout>