<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Simulador_de_Mergulho_Submarino">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="PAINEL DE CONTROLE DO SUBMARINO"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEscotilha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escotilha (Aberta / Trancada)" />

        <ToggleButton
            android:id="@+id/toggleSuporteVida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textOff="Suporte à Vida: DESLIGADO"
            android:textOn="Suporte à Vida: LIGADO" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Modo de Navegação:"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgModoNavegacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbManual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual" />

            <RadioButton
                android:id="@+id/rbAutomático"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Piloto Automático" />
        </RadioGroup>

        <EditText
            android:id="@+id/edtProfundidadeAlvo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Profundidade Alvo (em metros)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnIniciarMissao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Iniciar Missão" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSubmergir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Submergir (+50m)" />

            <Button
                android:id="@+id/btnEmergir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="Emergir (-50m)" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarMissao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Finalizar Missão" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Painel do Sonar / Status"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            android:focusable="false"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="8dp"
            android:scrollbars="vertical" />

    </LinearLayout>
</ScrollView>